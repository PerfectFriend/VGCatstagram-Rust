{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "VanGoghCat",
  "version": "2.0.0",
  "identifier": "eth.vangoghcat.gallery",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Van Gogh CryptoCats — Sovereign P2P Art Gallery",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Van Gogh CryptoCats Sovereign Node (Circle: 5/5 Healthy)"
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http: https: ws: wss: data: blob:"
    }
  }
}
